# ===================================================
# AShare Quant System - 环境变量配置模版
# 使用说明：复制本文件并重命名为 .env，填入您的真实 Token
# ===================================================

# 通道 1: PushPlus (推送加) - 推荐个人量化首选 (免费 200 条/天，微信扫码即用)
# 官网获取: http://www.pushplus.plus
PUSHPLUS_TOKEN=your_token_here

# 通道 2: Server酱 (Turbo版) - 极简微信推送 (免费 5 条/天)
# 官网获取: https://sct.ftqq.com
SERVERCHAN_KEY=your_sendkey_here

# 通道 3: 企业微信群机器人 Webhook (团队/长期零限流方案)
# 在企业微信群中右键添加机器人获取 Webhook 地址
WECOM_WEBHOOK=

# 通道 4: 钉钉 / 飞书群机器人 Webhook (可选)
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=
